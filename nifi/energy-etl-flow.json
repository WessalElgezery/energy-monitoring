{"flowContents":{"identifier":"6f58c25e-0c79-3edb-b8e3-9976631f43dd","instanceIdentifier":"13ef7e0c-01a2-1000-47b3-9acefb86cc8a","name":"NiFi Flow","comments":"","position":{"x":0.0,"y":0.0},"processGroups":[{"identifier":"e89cdf62-20cb-319e-a2e6-83bcfc0a50a6","instanceIdentifier":"1462c763-01a2-1000-0ca0-a4ab231ac973","name":"Energy Monitoring ETL","comments":"","position":{"x":1424.0,"y":344.0},"processGroups":[],"remoteProcessGroups":[],"processors":[{"identifier":"156b41bb-4083-3b3f-b5a3-7c63908d3255","instanceIdentifier":"01a21000-efa9-140d-9bea-50c2c29ddda2","name":"Validate JSON","comments":"","position":{"x":232.0,"y":192.0},"type":"org.apache.nifi.processors.groovyx.ExecuteGroovyScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-groovyx-nar","version":"1.27.0"},"properties":{"groovyx-script-body":"import groovy.json.JsonSlurper\nimport java.time.LocalDateTime\nimport java.time.format.DateTimeFormatter\nimport java.time.format.ResolverStyle\nimport org.apache.nifi.processor.io.InputStreamCallback\n\ndef flowFile = session.get()\nif (flowFile == null) return\n\nString rawJson = \"\"\n\nsession.read(flowFile, { inputStream ->\n    rawJson = inputStream.getText(\"UTF-8\")\n} as InputStreamCallback)\n\nString status = \"PASS\"\nString reason = \"Valid record\"\n\ntry {\n    def record = new JsonSlurper().parseText(rawJson)\n\n    // JSON root must be an object.\n    if (!(record instanceof Map)) {\n        throw new IllegalArgumentException(\n            \"JSON root must be an object\"\n        )\n    }\n\n    // Every expected field must exist.\n    def requiredFields = [\n        \"timestamp\", \"V\", \"A\", \"P_agg\",\n        \"ac_1\", \"kettle\", \"boiler\",\n        \"fridge\", \"washing_machine\", \"issues\"\n    ]\n\n    requiredFields.each { field ->\n        if (!record.containsKey(field)) {\n            throw new IllegalArgumentException(\n                \"Missing required field: ${field}\"\n            )\n        }\n    }\n\n    // All eight measurements must be numeric or null.\n    [\n        \"V\", \"A\", \"P_agg\",\n        \"ac_1\", \"kettle\", \"boiler\",\n        \"fridge\", \"washing_machine\"\n    ].each { field ->\n\n        if (record[field] != null &&\n            !(record[field] instanceof Number)) {\n            throw new IllegalArgumentException(\n                \"${field} must be numeric or null\"\n            )\n        }\n    }\n\n    // Issues must be an integer JSON number: 0 or 1.\n    def issues = record[\"issues\"]\n\n    if (!(issues instanceof Integer ||\n          issues instanceof Long ||\n          issues instanceof BigInteger)) {\n        throw new IllegalArgumentException(\n            \"issues must be an integer (0 or 1)\"\n        )\n    }\n\n    if (!(issues.toString() == \"0\" ||\n          issues.toString() == \"1\")) {\n        throw new IllegalArgumentException(\n            \"issues must be 0 or 1\"\n        )\n    }\n\n    // Validate timestamp format strictly.\n    if (!(record[\"timestamp\"] instanceof String)) {\n        throw new IllegalArgumentException(\n            \"timestamp must be a string\"\n        )\n    }\n\n    def formatter = DateTimeFormatter\n        .ofPattern(\"uuuu-MM-dd HH:mm:ss\")\n        .withResolverStyle(ResolverStyle.STRICT)\n\n    LocalDateTime.parse(record[\"timestamp\"], formatter)\n\n} catch (Exception e) {\n    status = \"FAIL\"\n    reason = e.message ?: \"Invalid JSON or record\"\n}\n\n// Preserve the original JSON. Only add validation attributes.\nflowFile = session.putAllAttributes(flowFile, [\n    \"validation.status\": status,\n    \"validation.reason\": reason\n])\n\n// Normal validation failures go to Route PASS/FAIL.\n// Unexpected processor errors use REL_FAILURE.\nsession.transfer(flowFile, REL_SUCCESS)\n","groovyx-failure-strategy":"transfer to failure","groovyx-additional-classpath":null,"groovyx-script-file":null},"propertyDescriptors":{"groovyx-script-body":{"name":"groovyx-script-body","displayName":"Script Body